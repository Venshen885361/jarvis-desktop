{
  "_doc": "第二受測對象 Home Assistant zh-TW 意圖（home-assistant-intents）。種子由每個意圖的前 2 條模板自動展開（分支取第一個、可選丟掉、slot 填固定值），expect 是原版的辨識結果。",
  "seeds": [
    {
      "id": "HassBroadcast_0",
      "text": "廣播吃飯了",
      "expect": "HassBroadcast:message=吃飯了",
      "template": "(廣播|通知)[大家][說]{message}"
    },
    {
      "id": "HassCancelAllTimers_0",
      "text": "取消客廳所有計時器",
      "expect": "HassCancelAllTimers:客廳",
      "template": "<timer_cancel>{area}[的](所有|全部)[的]<timer>"
    },
    {
      "id": "HassCancelAllTimers_1",
      "text": "取消所有計時器",
      "expect": "HassCancelAllTimers",
      "template": "<timer_cancel>(所有|全部)[的]<timer>"
    },
    {
      "id": "HassCancelTimer_0",
      "text": "取消客廳計時器",
      "expect": "HassCancelTimer:客廳",
      "template": "<timer_cancel>{area}[的]<timer>"
    },
    {
      "id": "HassCancelTimer_1",
      "text": "取消計時器",
      "expect": "HassCancelTimer",
      "template": "<timer_cancel>[我的]<timer>"
    },
    {
      "id": "HassClimateGetTemperature_0",
      "text": "客廳溫度",
      "expect": "HassClimateGetTemperature:客廳",
      "template": "{area}[的]<temp>[<how_many_is>]"
    },
    {
      "id": "HassClimateGetTemperature_1",
      "text": "溫度",
      "expect": "HassClimateGetTemperature:客廳",
      "template": "[現在]<temp>[<how_many_is>]"
    },
    {
      "id": "HassClimateSetTemperature_0",
      "text": "客廳26度",
      "expect": "HassClimateSetTemperature:客廳|temperature=26.0",
      "template": "[把|將]{area}[的][<temp>][<set_to>]{temperature}度"
    },
    {
      "id": "HassClimateSetTemperature_1",
      "text": "一樓26度",
      "expect": "HassClimateSetTemperature:一樓|temperature=26.0",
      "template": "[把|將]{floor}[的][<temp>][<set_to>]{temperature}度"
    },
    {
      "id": "HassDecreaseTimer_0",
      "text": "客廳計時器減1小時",
      "expect": "HassDecreaseTimer:客廳|hours=1.0",
      "template": "[幫|給|把|將][我的]{area}[的]<timer>(減|減少|縮短){timer_hours:hours}[個]小時"
    },
    {
      "id": "HassDecreaseTimer_1",
      "text": "客廳計時器減1小時5分鐘",
      "expect": "HassDecreaseTimer:客廳|hours=1.0,minutes=5.0",
      "template": "[幫|給|把|將][我的]{area}[的]<timer>(減|減少|縮短){timer_hours:hours}[個]小時[又]{timer_minutes:minutes}分鐘"
    },
    {
      "id": "HassFanSetSpeed_0",
      "text": "客廳風扇設為60",
      "expect": "HassFanSetSpeed:客廳|percentage=60.0",
      "template": "[把|將]{area}[的](風扇|電扇|吊扇)[的][轉速|速度]<set_to>[百分之]{fan_speed:percentage}[ ][%|趴]"
    },
    {
      "id": "HassFanSetSpeed_1",
      "text": "風扇設為60",
      "expect": "HassFanSetSpeed:客廳|percentage=60.0",
      "template": "[把|將][這裡|這邊][的](風扇|電扇|吊扇)[的][轉速|速度]<set_to>[百分之]{fan_speed:percentage}[ ][%|趴]"
