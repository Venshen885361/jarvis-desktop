# ==========================================================
# 複製這個檔案成 .env 再填值。.env 已經在 .gitignore 裡，不會被 commit。
# ==========================================================

# ---- 選擇後端 ----
# claude = Anthropic 官方 computer-use toolset（多步驟 GUI 任務較強）
# gemini = Google Gemini function calling（成本較低，靠視覺定位操作）
JARVIS_PROVIDER=claude

# ---- Anthropic（provider=claude 時必填）----
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# 只有「多工作區金鑰」需要填。金鑰若建立時已 scope 到單一 workspace 就留空。
# 沒填而金鑰又是多工作區的話，API 會回 400：
#   anthropic-workspace-id is required when authenticating with an identity-linked API key
# workspace id 在 https://platform.claude.com/settings/workspaces，格式 wrkspc_xxxxxxxx
ANTHROPIC_WORKSPACE_ID=
# 支援 computer_toolset_20260801 的模型。sonnet 是效能／價格的平衡點。
JARVIS_CLAUDE_MODEL=claude-sonnet-5
# 不需要看畫面的指令會降級到這顆，省錢
JARVIS_CLAUDE_MODEL_LIGHT=claude-haiku-4-5
JARVIS_CLAUDE_MAX_TOKENS=1024

# ---- Gemini（provider=gemini 時必填）----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
JARVIS_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
JARVIS_GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite

# ---- Token 節流（想更省就往下調）----
# 截圖送模型前縮到長邊多少像素。1024 是定位精度與成本的甜蜜點；
# 768 更省但小按鈕可能點不準，1280 更準但貴約 55%。
JARVIS_SCREENSHOT_MAX_EDGE=1024
JARVIS_SCREENSHOT_FORMAT=jpeg
JARVIS_SCREENSHOT_QUALITY=70
# 對話歷史保留幾輪
JARVIS_HISTORY_KEEP_TURNS=8
# 歷史裡最多留幾張截圖（舊的會被移除，這是最有效的一招）
JARVIS_HISTORY_KEEP_IMAGES=1
JARVIS_TOOL_RESULT_MAX_CHARS=600
JARVIS_PROMPT_CACHE=1
JARVIS_LOCAL_ROUTER=1

# ---- 行為 ----
JARVIS_MAX_TOOL_STEPS=12
JARVIS_ACTION_DELAY=0.15
# 設 1 才會放行完整 shell 權限。預設只允許唯讀白名單指令。
JARVIS_ALLOW_SHELL=0
# 設 1 用鍵盤打字取代麥克風（沒有麥克風也能玩）
JARVIS_TEXT_MODE=0

# ---- 語音 ----
JARVIS_STT_LANG=zh-TW
JARVIS_TTS_VOICE_ZH=zh-CN-YunxiNeural
JARVIS_TTS_VOICE_EN=en-GB-RyanNeural

# ---- HUD ----
JARVIS_WS_HOST=localhost
JARVIS_WS_PORT=8765
